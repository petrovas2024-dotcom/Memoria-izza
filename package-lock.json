.tech-grid{grid-template-columns:repeat(3,1fr)}.tech-card{text-align:center;position:relative}.avatar.tech{margin:auto;border-radius:50%;width:50px;height:50px}.tech-card>.badge{position:absolute;right:12px;top:12px}.tech-card>p{font-size:9px;color:var(--muted)}.tech-card>span{justify-content:center}.tech-stats{margin-top:12px;border-top:1px solid var(--line);padding-top:10px;display:grid;grid-template-columns:auto auto auto auto;align-items:center;justify-content:center;gap:5px}.tech-stats b{font-size:14px}.tech-stats small{font-size:8px;color:var(--muted);margin-right:8px}.edit-tech-button{width:100%;height:34px;margin-top:12px;border:1px solid var(--line);border-radius:8px;background:white;color:var(--navy);font-size:9px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:6px}.edit-tech-button:hover{border-color:var(--gold);background:#fffaf0}.technician-modal{width:min(520px,100%)}
.settings-layout{display:grid;grid-template-columns:1.45fr .75fr;gap:14px}.settings-brand{display:flex;align-items:center;gap:16px;margin-bottom:16px}.settings-brand img{width:76px;height:76px;object-fit:contain}.integration-card{background:var(--navy);color:white}.integration-card h2{font-size:18px}.integration-card p,.integration-card li{font-size:10px;color:#bdd0dd;line-height:1.5}.integration-card code{color:var(--gold)}.integration-icon{width:42px;height:42px;border-radius:11px;background:rgba(255,255,255,.1);display:grid;place-items:center;color:var(--gold)}
