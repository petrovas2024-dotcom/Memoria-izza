@import "tailwindcss";

:root{--navy:#06233f;--navy-2:#0b3455;--gold:#e3a51a;--white:#fff;--gray:#f2f4f6;--line:#dfe5e9;--text:#142536;--muted:#667785;--green:#16845b;--red:#c94545;--blue:#2376b9;--shadow:0 12px 32px rgba(6,35,63,.08)}
*{box-sizing:border-box}
html{background:#eef2f5}
body{margin:0;background:var(--gray);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
.material-save-state{display:block;margin-top:6px;font-size:11px;color:#718391}.material-save-state.saved{color:var(--green)}.material-save-state.error{color:var(--red)}.material-save-state.saving{color:var(--blue)}
button,input,select{font:inherit}
button,a{-webkit-tap-highlight-color:transparent}
button{cursor:pointer}
a{color:inherit;text-decoration:none}
.app-shell{min-height:100vh}
.sidebar{position:fixed;inset:0 auto 0 0;width:264px;background:var(--navy);color:white;display:flex;flex-direction:column;padding:24px 16px 18px;z-index:40}
.brand{display:flex;align-items:center;gap:12px;padding:0 8px 24px;border-bottom:1px solid rgba(255,255,255,.12)}
.brand img{width:54px;height:54px;object-fit:contain;filter:drop-shadow(0 5px 8px rgba(0,0,0,.3))}
.brand strong{display:block;font-size:18px;letter-spacing:.04em}
.brand span{font-size:11px;color:#aac0d1}
.sidebar nav{display:flex;flex-direction:column;gap:4px;margin-top:19px}
.nav-label{font-size:10px;letter-spacing:.14em;color:#6f91ab;font-weight:800;margin:14px 12px 7px}
.sidebar nav button{border:0;background:transparent;color:#c6d4df;min-height:44px;border-radius:9px;display:grid;grid-template-columns:23px 1fr auto;align-items:center;gap:9px;padding:0 12px;text-align:left;font-weight:650;font-size:14px}
.sidebar nav button:hover,.sidebar nav button.active{background:rgba(255,255,255,.1);color:#fff}
.sidebar nav button.active{box-shadow:inset 3px 0 var(--gold)}
.connection-card{margin-top:auto;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:13px}
.connection-card span{font-size:9px;letter-spacing:.1em;font-weight:850;color:var(--gold)}
.connection-card p{font-size:11px;color:#b5c5d1;line-height:1.45;margin:7px 0 10px}
.connection-card button{border:0;background:var(--gold);color:var(--navy);font-size:11px;font-weight:800;padding:8px 10px;border-radius:7px;width:100%}
.sidebar-foot{padding:16px 9px 0}.sidebar-foot p{font-size:11px;font-weight:700;margin:0 0 2px}.sidebar-foot small{font-size:9px;color:#8fa6b7}
.close-menu,.menu-button{display:none}
main{margin-left:264px;min-height:100vh}
.topbar{height:72px;background:white;border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 28px;position:sticky;top:0;z-index:30}
.global-search{height:42px;width:min(480px,42vw);background:var(--gray);border:1px solid transparent;border-radius:10px;display:flex;align-items:center;gap:10px;padding:0 14px;color:#8495a2}
.global-search:focus-within{border-color:#9bb5c7;background:white;box-shadow:0 0 0 3px rgba(35,118,185,.1)}
.global-search input{border:0;outline:0;background:transparent;width:100%;font-size:13px;color:var(--text)}
.top-actions{margin-left:auto;display:flex;align-items:center;gap:12px}
.whatsapp-button{height:38px;display:flex;align-items:center;gap:7px;padding:0 12px;border-radius:9px;background:#e9f8f1;color:#11734d;font-size:12px;font-weight:750}
.notification,.icon-button{border:1px solid var(--line);background:white;width:38px;height:38px;border-radius:9px;display:grid;place-items:center;position:relative}
.notification i{position:absolute;right:-3px;top:-5px;background:var(--gold);font-size:9px;width:17px;height:17px;border-radius:50%;display:grid;place-items:center;font-style:normal;font-weight:800}
.user-chip{display:flex;align-items:center;gap:9px;border-left:1px solid var(--line);padding-left:14px}
.user-chip>div{width:36px;height:36px;border-radius:9px;background:var(--navy);color:white;display:grid;place-items:center;font-size:12px;font-weight:800}
.user-chip span{display:flex;flex-direction:column}.user-chip strong{font-size:12px}.user-chip small{font-size:10px;color:var(--muted);margin-top:2px}
.workspace{padding:28px;max-width:1540px;margin:auto}
.page-heading{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:24px}
.eyebrow{margin:0 0 5px;font-size:9px;letter-spacing:.13em;font-weight:900;color:#8193a0}
.page-heading h1{margin:0;font-size:28px;color:var(--navy);letter-spacing:-.025em}.page-heading>div>p:last-child{margin:5px 0 0;color:var(--muted);font-size:12px}
.heading-actions,.modal-actions{display:flex;gap:9px}
.primary-button,.secondary-button{min-height:40px;border-radius:9px;padding:0 15px;display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:750;font-size:12px}
.primary-button{background:var(--gold);color:var(--navy);border:1px solid var(--gold);box-shadow:0 5px 15px rgba(227,165,26,.2)}
.primary-button:hover{background:#efb42f}.secondary-button{background:white;color:var(--navy);border:1px solid var(--line)}.secondary-button:hover{border-color:#aac0cf}
.metrics-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:14px}
.metric-card,.card{background:white;border:1px solid #e3e8ec;border-radius:13px;box-shadow:0 2px 4px rgba(6,35,63,.025)}
.metric-card{display:flex;align-items:center;gap:13px;padding:16px}
.metric-icon{width:42px;height:42px;border-radius:10px;display:grid;place-items:center;background:#e9eff4;color:var(--navy)}.metric-icon.gold{background:#fff5db;color:#a96f00}.metric-icon.blue{background:#e8f3fb;color:var(--blue)}.metric-icon.green{background:#e8f6f0;color:var(--green)}
.metric-card p{font-size:10px;color:var(--muted);margin:0 0 2px;font-weight:650}.metric-card strong{font-size:23px;color:var(--navy);display:block;line-height:1.1}.metric-card small{font-size:9px;color:#8b9aa5}
.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(270px,.8fr);gap:14px}
.card{padding:18px}
.card-head,.module-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px}.card-head h2,.module-head h2{font-size:16px;margin:0;color:var(--navy)}.module-head p{margin:4px 0 0;font-size:11px;color:var(--muted)}
.text-button{border:0;background:transparent;color:var(--blue);font-size:11px;font-weight:750;display:flex;align-items:center;gap:4px}.count{width:24px;height:24px;border-radius:7px;background:#fff0c8;color:#9b6800;font-size:10px;font-weight:850;display:grid;place-items:center}
.timeline{display:flex;flex-direction:column}.timeline-item{display:grid;grid-template-columns:47px 14px minmax(0,1fr) 34px;gap:10px;min-height:74px}.time strong{font-size:12px;display:block}.time span{font-size:9px;color:var(--muted)}.line{display:flex;justify-content:center;position:relative}.line:after{content:"";position:absolute;top:10px;bottom:-5px;width:1px;background:#d7e0e6}.timeline-item:last-child .line:after{display:none}.line i{position:relative;z-index:1;width:9px;height:9px;border-radius:50%;background:#9fb0bc;border:2px solid white;box-shadow:0 0 0 1px #9fb0bc}.line i.current{background:var(--gold);box-shadow:0 0 0 1px var(--gold)}
.service-info>div{display:flex;align-items:center;gap:7px}.service-info strong{font-size:12px}.service-info p{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--muted);margin:4px 0}.timeline-item>a{width:31px;height:31px;border-radius:8px;background:#e8f6f0;color:var(--green);display:grid;place-items:center}
.badge{display:inline-flex;align-items:center;padding:4px 7px;border-radius:999px;font-size:8px;font-weight:800;white-space:nowrap}.badge-green{background:#e6f5ee;color:#147451}.badge-blue{background:#e6f1f9;color:#1f679c}.badge-gold{background:#fff2cf;color:#966500}.badge-red{background:#feeaea;color:#b83c3c}.badge-gray{background:#edf1f3;color:#5e6b74}
.income{background:var(--gray);border-radius:11px;padding:14px}.income span,.income small{display:block;font-size:9px;color:var(--muted)}.income strong{display:block;font-size:25px;color:var(--navy);margin:3px 0}.progress{height:6px;border-radius:5px;background:#dfe6ea;margin-top:10px;overflow:hidden}.progress i{display:block;height:100%;background:var(--gold);border-radius:5px}.finance-list{padding:10px 1px}.finance-list>div{display:flex;justify-content:space-between;font-size:11px;padding:6px 0}.finance-list span{display:flex;align-items:center;gap:7px}.dot{width:7px;height:7px;border-radius:50%}.dot.green{background:var(--green)}.dot.gold{background:var(--gold)}.dot.blue{background:var(--blue)}.wide-button{width:100%}
.alerts-card{grid-column:2}.alert{display:flex;gap:10px;padding:10px;border-radius:9px;margin-bottom:8px}.alert svg{width:17px;flex:0 0 auto}.alert strong{font-size:10px}.alert p{font-size:9px;color:var(--muted);margin:2px 0 0}.alert.warning{background:#fff7e4;color:#8d6100}.alert.info{background:#eef6fc;color:#276990}.alert.neutral{background:#f3f5f7}
.quick-card{grid-row:2;grid-column:1}.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.quick-grid button{background:#f8fafb;border:1px solid var(--line);border-radius:10px;text-align:left;padding:12px;min-height:100px}.quick-grid button:hover{border-color:var(--gold);transform:translateY(-1px)}.quick-grid span{width:31px;height:31px;display:grid;place-items:center;border-radius:8px;background:white;color:var(--navy);box-shadow:0 2px 7px rgba(6,35,63,.08)}.quick-grid svg{width:16px}.quick-grid strong{display:block;font-size:10px;margin-top:9px}.quick-grid small{font-size:8px;color:var(--muted)}
.module-card{min-height:570px}.module-head{align-items:center;border-bottom:1px solid var(--line);padding-bottom:15px}.module-actions{display:flex;align-items:center;gap:8px}.quote-template-banner{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 15px;margin-bottom:14px;border:1px solid #ecd08a;border-radius:10px;background:#fffaf0}.quote-template-banner>div{display:flex;align-items:center;gap:11px}.quote-template-banner>div>svg{width:30px;height:30px;color:var(--gold)}.quote-template-banner span{display:flex;flex-direction:column}.quote-template-banner strong{font-size:11px;color:var(--navy)}.quote-template-banner small{font-size:9px;color:var(--muted);margin-top:3px}.quote-template-banner>a{display:flex;align-items:center;gap:6px;color:var(--navy);font-size:10px;font-weight:800;white-space:nowrap}
.toolbar{display:flex;justify-content:space-between;gap:12px;margin-bottom:16px}.segmented{display:flex;background:var(--gray);border-radius:9px;padding:3px}.segmented button{border:0;background:transparent;padding:8px 14px;border-radius:7px;font-size:10px;font-weight:750;color:var(--muted)}.segmented button.active{background:white;color:var(--navy);box-shadow:0 2px 5px rgba(6,35,63,.08)}.filters{display:flex;gap:8px}.filters select,.form-grid input,.form-grid select,.quote-line input,.quote-options input{height:38px;border:1px solid var(--line);border-radius:8px;background:white;padding:0 10px;color:var(--text);font-size:11px;outline:0}.filters select{min-width:145px}
.data-table{border:1px solid var(--line);border-radius:10px;overflow:hidden}.table-row{display:grid;grid-template-columns:1.05fr 1.7fr 1fr .72fr .9fr .55fr;align-items:center;min-height:58px;padding:8px 13px;border-bottom:1px solid var(--line);gap:10px;font-size:10px}.table-row:last-child{border-bottom:0}.table-row:hover:not(.table-header){background:#fafcfd}.table-header{min-height:37px;background:var(--navy);color:white;font-size:8px;text-transform:uppercase;letter-spacing:.07em;font-weight:800}.table-row span{min-width:0}.table-row span>strong,.table-row span>small{display:block}.table-row small{font-size:8px;color:var(--muted);margin-top:3px}.row-actions{display:flex;gap:5px}.row-actions a,.row-actions button{width:29px;height:29px;border:1px solid var(--line);border-radius:7px;background:white;display:grid;place-items:center;color:var(--navy)}
.calendar-preview{text-align:center;padding:24px;color:var(--muted)}.calendar-preview h3{color:var(--navy);margin:15px 0 3px}.calendar-preview p{font-size:11px}.calendar-navigation{display:grid;grid-template-columns:38px auto minmax(170px,1fr) 38px;align-items:center;gap:8px;max-width:620px;margin:0 auto}.calendar-navigation button{height:36px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--navy);display:grid;place-items:center;font-size:10px;font-weight:800}.calendar-navigation button svg{width:17px}.calendar-navigation .calendar-today{padding:0 12px}.calendar-navigation strong{text-transform:capitalize;color:var(--navy);font-size:13px}.calendar-days{display:grid;grid-template-columns:repeat(7,minmax(120px,1fr));gap:7px;margin-top:20px;text-align:left;overflow:auto}.calendar-days.calendar-day{grid-template-columns:minmax(280px,680px);justify-content:center}.calendar-days>div{border:1px solid var(--line);border-radius:9px;min-height:170px;padding:9px;background:#fff}.calendar-days>div>strong{display:block;font-size:10px;color:var(--navy);margin-bottom:8px;text-transform:capitalize}.calendar-service{display:block;width:100%;text-align:left;background:#eef5fa;border:0;border-left:3px solid var(--blue);padding:8px;margin-bottom:6px;font-size:8px;border-radius:4px;color:var(--text)}.calendar-service b,.calendar-service small{display:block}.calendar-service small{margin:4px 0;color:var(--muted)}.calendar-service .badge{font-size:7px}.calendar-empty-day{display:block;padding:18px 4px;font-size:9px;color:#98a5ae}.calendar-current-day{box-shadow:inset 0 0 0 2px var(--gold)}.calendar-month{margin-top:20px;text-align:left;overflow:auto}.calendar-weekdays,.calendar-month-grid{display:grid;grid-template-columns:repeat(7,minmax(105px,1fr));min-width:735px}.calendar-weekdays span{padding:7px;text-align:center;color:var(--navy);font-size:9px;font-weight:900}.calendar-month-grid>div{min-height:100px;border:1px solid var(--line);padding:7px;background:#fff}.calendar-month-grid>div>strong{display:block;color:var(--navy);font-size:10px;margin-bottom:5px}.calendar-month-grid button{display:block;width:100%;border:0;border-radius:4px;background:#eef5fa;color:var(--navy);font-size:7px;text-align:left;padding:5px;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.calendar-month-grid .outside-month{opacity:.42;background:#f6f8f9}.calendar-month-grid small{font-size:7px;color:var(--muted)}.agenda-empty-filter{padding:45px 20px;text-align:center;color:var(--muted)}.agenda-empty-filter svg{color:var(--gold)}.agenda-empty-filter strong,.agenda-empty-filter span{display:block}.agenda-empty-filter strong{color:var(--navy);margin:7px 0 3px}
.client-grid,.order-grid,.tech-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.client-card,.order-card,.tech-card{border:1px solid var(--line);border-radius:11px;padding:15px;background:#fff}.client-top{display:flex;justify-content:space-between}.client-top button{border:0;background:transparent}.avatar{width:38px;height:38px;border-radius:10px;background:var(--navy);color:white;display:grid;place-items:center;font-size:11px;font-weight:800}.client-card h3,.order-card h3,.tech-card h3{font-size:13px;margin:11px 0 2px}.company{font-size:9px;color:var(--gold);font-weight:800;margin:0 0 12px}.client-contact{display:flex;flex-direction:column;gap:6px}.client-contact span,.order-card>p,.tech-card>span{display:flex;align-items:center;gap:6px;font-size:9px;color:var(--muted);margin:5px 0}.client-contact svg,.order-card>p svg,.tech-card>span svg{width:13px;height:13px}.client-stats{display:grid;grid-template-columns:1fr 1fr;border-block:1px solid var(--line);margin:13px 0;padding:10px 0}.client-stats span{display:flex;flex-direction:column}.client-stats span+span{border-left:1px solid var(--line);padding-left:12px}.client-stats small{font-size:8px;color:var(--muted)}.client-stats strong{font-size:12px;margin-top:2px}.client-stats .due{color:var(--red)}.client-actions{display:flex;justify-content:space-between}.client-actions a,.client-actions button{border:0;background:transparent;font-size:9px;font-weight:750;display:flex;align-items:center;gap:4px;color:var(--blue)}.client-actions a{color:var(--green)}.client-actions svg{width:14px}
