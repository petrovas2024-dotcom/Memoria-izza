@media(max-width:800px){.user-role-summary{grid-template-columns:1fr 1fr 1fr}.user-row{grid-template-columns:1.35fr .8fr .55fr;min-width:0}.user-row>span:nth-child(4),.user-header>span:nth-child(4){display:none}.user-actions{justify-content:flex-end}.user-table{overflow:visible}.user-header{display:none}.user-row{border:1px solid var(--line);border-radius:10px;margin-bottom:9px}.user-table{border:0}.user-role-summary article{padding:10px;gap:7px}.user-role-summary svg{display:none}.user-role-summary strong{font-size:17px}}
@media(max-width:520px){.user-role-summary{gap:6px}.user-role-summary small{font-size:7px}.user-row{grid-template-columns:1fr auto}.user-row>span:nth-child(2){grid-column:1}.user-row>span:nth-child(3){grid-column:2;grid-row:1}.user-row>span:nth-child(5){grid-column:2;grid-row:2}.user-admin .module-head{align-items:flex-start}}
.tech-header>div{display:flex;align-items:center;gap:11px}.tech-header img{object-fit:contain}.tech-header span{display:flex;flex-direction:column}.tech-header strong{font-size:16px}.tech-header small{font-size:10px;color:#b9cad6;margin-top:2px}
.tech-workspace{max-width:980px;margin:auto;padding:26px 18px 60px}.tech-order-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.tech-order h2{font-size:17px;color:var(--navy);margin:14px 0 9px}.tech-order>p{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);margin:6px 0}.tech-order>p svg{width:15px}
.tech-contact-actions{display:flex;gap:8px;margin:14px 0}.tech-contact-actions>*{flex:1;justify-content:center}.tech-order>label{display:flex;flex-direction:column;gap:6px;font-size:10px;font-weight:800;color:var(--navy);margin-top:12px}.tech-order select,.tech-order textarea{border:1px solid var(--line);border-radius:8px;padding:10px;background:white}.tech-order textarea{min-height:95px;resize:vertical}
.evidence-upload{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.evidence-upload label{border:1px dashed #a8b9c5;background:#f8fafb;border-radius:9px;min-height:58px;display:flex;align-items:center;justify-content:center;gap:7px;font-size:10px;font-weight:800;color:var(--navy);cursor:pointer}.evidence-upload input{display:none}.save-tech-order{width:100%;margin-top:13px}
@media(max-width:700px){.login-card{padding:26px 20px}.tech-header{padding:0 14px}.tech-header .secondary-button{padding:0 10px}.tech-order-list{grid-template-columns:1fr}.evidence-upload{grid-template-columns:1fr}.tech-contact-actions{flex-direction:column}}
